# Database — PostgreSQL via Neon
# Get one at https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth — single-user API key
# Leave unset for unauthenticated development.
APP_API_KEY="changeme"

# AI Agent — OpenRouter
# Get a free API key at https://openrouter.ai/keys
# Free models available: openai/gpt-4o-mini, meta-llama/llama-3.2-3b-instruct, google/gemini-2.0-flash-exp
OPENROUTER_API_KEY="sk-or-v1-..."
# Optional: model override (default: openai/gpt-4o-mini)
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Optional: OpenRouter base URL (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Optional: agent timeout in ms (default: 30000)
AGENT_TIMEOUT_MS=30000
